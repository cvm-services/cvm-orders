{
  "tasks": {
    "test": "deno test --coverage=coverage --allow-read --allow-write --allow-env --allow-net --allow-run=deno tests/",
    "coverage": "deno coverage coverage --lcov --include='src/' > coverage.lcov"
  },
  "imports": {
    "nostr-tools": "npm:nostr-tools@2"
  },
  "fmt": { "useTabs": false, "lineWidth": 100 }
}
